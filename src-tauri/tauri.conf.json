{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aqua",
  "version": "0.1.0",
  "identifier": "com.anduscheusan.aqua",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aqua",
        "width": 1200,
        "height": 1000
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "dmg": {
        "background": null,
        "windowPosition": {
          "x": 400,
          "y": 300
        },
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 130,
          "y": 150
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 150
        }
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "certificateThumbprint": null,
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/sign-windows.ps1",
          "%1"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "languages": ["English", "Romanian"],
        "startMenuFolder": "Aqua"
      }
    }
  }
}
